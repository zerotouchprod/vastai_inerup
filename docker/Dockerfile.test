# Dockerfile.test — Lightweight test image for video generation pipeline
# NO GPU, NO torch, NO diffusers — pure logic & mock testing
# Target size: ~500MB | Test runtime: <30s
#
# Usage:
#   docker build -f docker/Dockerfile.test -t vastai-gen-test .
#   docker run --rm vastai-gen-test

FROM python:3.11-slim

LABEL maintainer="vastai_inerup"
LABEL description="Lightweight test runner: text2video + image2video (mocked)"

# ffmpeg needed by imageio-ffmpeg to write test .mp4 files
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install test deps first (cached layer)
COPY requirements.test.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.test.txt

# Source & tests
COPY src/ /app/src/
COPY tests/ /app/tests/
COPY pytest.ini /app/

ENV PYTHONPATH="/app"
ENV PYTHONUNBUFFERED="1"
# Prevent any real HF network calls inside tests
ENV HF_HUB_OFFLINE="1"
ENV TRANSFORMERS_OFFLINE="1"
# Disable safety checker by default in tests
ENV GEN_ENABLE_SAFETY_CHECKER="false"

CMD ["pytest", \
     "tests/unit/test_gen_models.py", \
     "tests/unit/test_gen_config.py", \
     "tests/unit/test_generation_result.py", \
     "tests/unit/test_domain_generation.py", \
     "tests/unit/test_base_engine.py", \
     "tests/integration/test_text2video_full.py", \
     "tests/integration/test_image2video_full.py", \
     "tests/integration/test_universal_mode.py", \
     "-v", \
     "--tb=short", \
     "--timeout=30", \
     "--cov", \
     "--cov-config=.coveragerc", \
     "--cov-report=term-missing", \
     "--cov-fail-under=80", \
     "-m", "not slow"]
