# Dockerfile.serverless — RunPod Serverless HunyuanVideo T2V
#
# Single-stage build на базе runpod/pytorch (torch 2.4.1 + cu124).
# Models (Network Volume /workspace/models/HunyuanVideo): ~30 GB

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

LABEL maintainer="vastai_inerup"
LABEL description="RunPod Serverless — HunyuanVideo T2V"
LABEL version="7.0.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git libgl1 libglib2.0-0 libsm6 libxext6 \
    libxrender-dev libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

# flash-attn в базовом образе несовместим с diffusers HunyuanVideo — удалить ДО установки
RUN pip uninstall -y flash-attn 2>/dev/null || true

# ── ML stack ──────────────────────────────────────────────────────────────────
# torch/torchvision НЕ трогаем — базовый образ (2.4.1+cu124)
# diffusers 0.32.2 — последняя версия с HunyuanVideoPipeline БЕЗ infer_schema бага
# (баг появился в 0.33.0 из-за torch.compile несовместимого с torch 2.4.1)
RUN pip install --no-cache-dir \
    "diffusers==0.32.2" \
    "transformers==4.46.1" \
    "accelerate==1.0.0" \
    "safetensors>=0.4.5" \
    "huggingface_hub[cli]>=0.25.0" \
    sentencepiece==0.2.0 \
    protobuf==5.29.0 \
    imageio[ffmpeg]==2.34.0 \
    imageio-ffmpeg==0.5.0 \
    boto3==1.34.0 \
    pydantic==2.7.0 \
    pydantic-settings==2.3.0 \
    numpy==1.26.4 \
    pillow==10.4.0 \
    tqdm==4.66.0 \
    requests==2.32.0 \
    cryptography==42.0.8 \
    paramiko==3.4.0 \
    runpod==1.8.1


WORKDIR /app

COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY test_input.json /app/test_input.json
COPY debug_handler.py /app/debug_handler.py

RUN mkdir -p /workspace/models

ENV PYTHONPATH="/app"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
ENV HF_HOME="/workspace/huggingface_cache"
ENV HF_HUB_OFFLINE="1"
ENV R2_DEFAULT_REGION="auto"

RUN python3 -c "import torch, diffusers, transformers; print('torch:', torch.__version__, '| diffusers:', diffusers.__version__)"

RUN printf '#!/bin/bash\npython3 -c "import torch; exit(0 if torch.cuda.is_available() else 1)"\n' \
    > /healthcheck.sh && chmod +x /healthcheck.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD /healthcheck.sh

CMD ["python3", "-m", "src.entrypoints.runpod_handler"]
