# Dockerfile.serverless - Ultra-fast startup for RunPod Serverless
# Base: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime (heavily cached by RunPod)
# Size: ~6GB (dependencies only, NO models)
# Models are stored on Network Volume at /runpod-volume/models/
# Cold start: <5 seconds when image is cached on host

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

LABEL maintainer="vastai_inerup"
LABEL description="RunPod Serverless Video Generation - Ultra-fast startup"
LABEL version="2.0.0"

# Minimal system dependencies (ffmpeg + OpenGL for image processing)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Copy requirements file
COPY requirements.gen.txt .

# Install Python dependencies with exact versions for compatibility
# Используем точные версии, которые точно работают вместе
RUN pip install --no-cache-dir \
    torch==2.5.1+cu124 \
    torchvision==0.20.1+cu124 \
    torchaudio==2.5.1+cu124 \
    --index-url https://download.pytorch.org/whl/cu124

# Установить совместимые версии diffusers и transformers
# diffusers 0.28.0 и transformers 4.40.0 хорошо работают вместе
# safetensors>=0.4.1 required by transformers==4.40.0; 0.4.3 satisfies both
RUN pip install --no-cache-dir \
    diffusers==0.28.0 \
    transformers==4.40.0 \
    accelerate==0.30.0 \
    safetensors==0.4.3 \
    huggingface_hub[cli]==0.22.0 \
    tiktoken==0.12.0 \
    sentencepiece==0.2.0 \
    protobuf==7.34.0 \
    imageio[ffmpeg]==2.34.0 \
    imageio-ffmpeg==0.5.0 \
    boto3==1.34.0 \
    pydantic==2.0.0 \
    pydantic-settings==2.0.0 \
    numpy==1.24.0 \
    pillow==10.0.0 \
    tqdm==4.65.0 \
    requests==2.31.0

# Install RunPod serverless dependency
RUN pip install --no-cache-dir runpod==1.8.1

# Install xformers for memory-efficient attention (совместимая версия)
RUN pip install --no-cache-dir xformers==0.0.29.post1 --index-url https://download.pytorch.org/whl/cu124

# Copy source code (simplified - copy entire src directory)
COPY src/ /app/src/

# Create model directory structure (will be mounted from network volume)
RUN mkdir -p /runpod-volume/models

# CRITICAL: Environment variables for offline operation
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
ENV HF_HOME="/runpod-volume/huggingface_cache"
ENV HF_HUB_OFFLINE="1"
ENV TORCH_INFERENCE_MODE="1"
ENV ENABLE_SAFETY_CHECKER="False"

# Verify installation (quick check)
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')" && \
    python3 -c "import runpod; print(f'RunPod: {runpod.__version__}')"

# Health check for RunPod
RUN echo '#!/bin/bash\npython3 -c "import torch; exit(0 if torch.cuda.is_available() else 1)"' > /healthcheck.sh && \
    chmod +x /healthcheck.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /healthcheck.sh

# Direct CMD for RunPod Serverless (no entrypoint script needed)
CMD ["python", "-m", "src.entrypoints.runpod_handler"]
