# Dockerfile.serverless - Lightweight image for RunPod Serverless
# Base: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
# Size: ~6GB (dependencies only, no models)
# Models will be stored on RunPod Network Volume mounted at /runpod-volume

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

LABEL maintainer="vastai_inerup"
LABEL description="RunPod Serverless Video Generation - Lightweight image"
LABEL version="1.0.0"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install base dependencies
RUN pip install --no-cache-dir --upgrade pip

# Install PyTorch (already in base image, but ensure compatibility)
RUN pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1

# Copy requirements file
COPY requirements.gen.txt .

# Install Python dependencies from requirements.gen.txt
RUN pip install --no-cache-dir -r requirements.gen.txt

# Install RunPod and additional serverless dependencies
RUN pip install --no-cache-dir \
    runpod==2.4.0 \
    boto3==1.34.0 \
    huggingface-hub==0.24.0

# Install xformers for optimization
RUN pip install --no-cache-dir xformers==0.0.29.post1 --index-url https://download.pytorch.org/whl/cu124

# Copy source code
COPY src/ /app/src/

# Create model directory structure (will be mounted from network volume)
RUN mkdir -p /runpod-volume/models

# Environment variables for RunPod
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
ENV HF_HOME="/runpod-volume/huggingface"
ENV TORCH_INFERENCE_MODE="1"
ENV ENABLE_SAFETY_CHECKER="False"

# Verify installation
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')" && \
    python3 -c "import runpod; print(f'RunPod: {runpod.__version__}')"

# Default command for RunPod Serverless
CMD ["python", "-m", "src.entrypoints.runpod_handler"]