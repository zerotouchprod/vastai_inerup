# Dockerfile.serverless - Ultra-fast startup for RunPod Serverless
# Base: runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
#   → Pre-cached on ALL RunPod workers — zero download overhead
#   → Includes PyTorch 2.4, CUDA 12.4, Python 3.11
# Size: ~6GB (dependencies only, NO models)
# Models are stored on Network Volume at /workspace/models/
# Cold start: <5 seconds when image is cached on host

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

LABEL maintainer="vastai_inerup"
LABEL description="RunPod Serverless Video Generation - Ultra-fast startup"
LABEL version="2.0.0"

# Minimal system dependencies (ffmpeg + OpenGL for image processing)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Install Python dependencies with exact versions for compatibility
# PyTorch уже включён в базовый образ runpod/pytorch — пропускаем его установку

# Установить совместимые версии diffusers и transformers
# diffusers 0.28.0 и transformers 4.40.0 хорошо работают вместе
# safetensors>=0.4.1 required by transformers==4.40.0; 0.4.3 satisfies both
# pydantic==2.7.0 — минимум, требуемый fastapi (транзитивная зависимость runpod)
# pydantic-settings==2.3.0 — совместима с pydantic>=2.7
RUN pip install --no-cache-dir \
    diffusers==0.28.0 \
    transformers==4.40.0 \
    accelerate==0.30.0 \
    safetensors==0.4.3 \
    huggingface_hub[cli]==0.22.0 \
    tiktoken==0.12.0 \
    sentencepiece==0.2.0 \
    protobuf==5.29.0 \
    imageio[ffmpeg]==2.34.0 \
    imageio-ffmpeg==0.5.0 \
    boto3==1.34.0 \
    pydantic==2.7.0 \
    pydantic-settings==2.3.0 \
    numpy==1.26.4 \
    pillow==10.4.0 \
    tqdm==4.66.0 \
    requests==2.32.0 \
    runpod==1.8.1

# Install xformers — используем extra-index-url + constraint на torch чтобы
# pip не переустанавливал torch из базового образа (2.4.1+cu124)
# Constraint заморозит torch, pip возьмёт совместимый xformers без апгрейда
RUN TORCH_VERSION=$(python3 -c "import torch; print(torch.__version__)") && \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cu124 \
        "torch==${TORCH_VERSION}" \
        "xformers==0.0.28.post1"

# Copy source code (simplified - copy entire src directory)
COPY src/ /app/src/

# Create model directory structure (will be mounted from network volume at /workspace)
RUN mkdir -p /workspace/models

# CRITICAL: Environment variables for offline operation
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
ENV HF_HOME="/workspace/huggingface_cache"
ENV HF_HUB_OFFLINE="1"
ENV TORCH_INFERENCE_MODE="1"
ENV ENABLE_SAFETY_CHECKER="False"

# Verify installation (quick check)
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')" && \
    python3 -c "import runpod; print(f'RunPod: {runpod.__version__}')"

# Health check for RunPod
RUN echo '#!/bin/bash\npython3 -c "import torch; exit(0 if torch.cuda.is_available() else 1)"' > /healthcheck.sh && \
    chmod +x /healthcheck.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /healthcheck.sh

# Direct CMD for RunPod Serverless (no entrypoint script needed)
CMD ["python", "-m", "src.entrypoints.runpod_handler"]
