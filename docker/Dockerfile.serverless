# Dockerfile.serverless - Ultra-fast startup for RunPod Serverless
#
# Multi-stage build:
#   Stage 1 (builder): runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
#     → устанавливаем все зависимости
#   Stage 2 (final):   nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
#     → копируем только Python + установленные пакеты (~slim образ)
#     → финальный образ НЕ содержит CUDA compiler/headers → меньше размер
#
# Models are stored on Network Volume at /workspace/models/

# ── Stage 1: install dependencies ────────────────────────────────────────────
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04 AS builder

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

# Установить все зависимости включая явные транзитивные
# CogVideoXImageToVideoPipeline добавлен в diffusers>=0.30.0
# six — требуется transformers.generation.utils
# cryptography + paramiko — требуются runpod.cli.groups.ssh
RUN pip install --no-cache-dir \
    diffusers==0.32.2 \
    transformers==4.49.0 \
    accelerate==1.3.0 \
    safetensors==0.4.5 \
    huggingface_hub[cli]==0.27.0 \
    tiktoken==0.12.0 \
    sentencepiece==0.2.0 \
    protobuf==5.29.0 \
    imageio[ffmpeg]==2.34.0 \
    imageio-ffmpeg==0.5.0 \
    boto3==1.34.0 \
    pydantic==2.7.0 \
    pydantic-settings==2.3.0 \
    numpy==1.26.4 \
    pillow==10.4.0 \
    tqdm==4.66.0 \
    requests==2.32.0 \
    six==1.16.0 \
    cryptography==42.0.8 \
    paramiko==3.4.0 \
    runpod==1.8.1


# ── Stage 2: slim runtime image ───────────────────────────────────────────────
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

LABEL maintainer="vastai_inerup"
LABEL description="RunPod Serverless Video Generation - Ultra-fast startup"
LABEL version="3.0.0"

# Minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-distutils \
    python3-pip \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

# Копируем Python пакеты из builder-стадии
# dist-packages — системные пакеты builder-образа (torch, numpy и т.д.)
# site-packages — пакеты установленные через pip в builder
COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=builder /usr/local/bin /usr/local/bin
# на случай если часть пакетов в builder лежит в dist-packages
COPY --from=builder /usr/lib/python3 /usr/lib/python3

WORKDIR /app

COPY src/ /app/src/

RUN mkdir -p /workspace/models

ENV PYTHONPATH="/app"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
ENV HF_HOME="/workspace/huggingface_cache"
ENV HF_HUB_OFFLINE="1"
ENV TORCH_INFERENCE_MODE="1"
ENV ENABLE_SAFETY_CHECKER="False"

# Verify installation
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA available at runtime: check with nvidia-smi')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')" && \
    python3 -c "import runpod; print(f'RunPod: {runpod.__version__}')"

RUN echo '#!/bin/bash\npython3 -c "import torch; exit(0)"' > /healthcheck.sh && \
    chmod +x /healthcheck.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /healthcheck.sh

CMD ["python3", "-m", "src.entrypoints.runpod_handler"]
