# EXPERIMENT ONLY: RunPod Serverless image = released worker image + runpod SDK + handler. Not used by prod.
ARG BASE=ghcr.io/zerotouchprod/aividup-worker@sha256:ae4e12a6b5892ea855e3cdbbffc536f7ac9dd51aed0a13f7d225b7eb9153da7d
FROM ${BASE}
RUN python3 -m pip install --no-cache-dir "runpod==1.7.*"
COPY src/serverless /workspace/project/src/serverless
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-u", "-m", "src.serverless.handler"]
