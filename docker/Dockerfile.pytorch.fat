# Dockerfile.pytorch.fat
# Full PyTorch fat image (CUDA + PyTorch + Real-ESRGAN dependencies). This Dockerfile
# uses a multi-stage wheelbuilder to prebuild Python wheels and install them from a
# local wheelhouse to avoid heavy network downloads during final image build.
# Build locally:
#   docker build -f Dockerfile.pytorch.fat -t vastai-interup:pytorch-fat .

# Используем базовый образ с CUDA 12.1 для лучшей совместимости с PyTorch
# CUDA 12.1 имеет forward compatibility с CUDA 12.2-12.4
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

# Install only runtime deps (keep the image small)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    curl \
    git \
    python3-pip \
    python3-venv \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    tesseract-ocr \
    libtesseract-dev \
    libgl1-mesa-glx \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/project

# Create and use venv to avoid system package issues
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install minimal Python packages
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Устанавливаем PyTorch с поддержкой CUDA 12.1 (совместим с CUDA 12.2+)
# CUDA 12.1 совместим с CUDA 12.2, 12.3, 12.4 через forward compatibility
RUN pip uninstall -y torch torchvision || true && \
    echo "Installing PyTorch with CUDA 12.1 support (forward compatible with CUDA 12.2-12.4)..." && \
    echo "Note: Building on machine without GPU, but installing CUDA-enabled PyTorch for runtime use on GPU machines" && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu121 && \
    echo "Verifying PyTorch installation..." && \
    python3 -c "import torch; print(f'PyTorch version: {torch.__version__}'); print(f'PyTorch built with CUDA: {\"cu\" in torch.__version__}')" && \
    echo "PyTorch installation complete. GPU availability will be checked at runtime." && \
    rm -rf /root/.cache/pip

# Lightweight Python utilities used by scripts
# Pin numpy<2 FIRST to avoid compatibility issues with some older packages
RUN pip install --no-cache-dir "numpy<2" && \
    rm -rf /root/.cache/pip

# Install Real-ESRGAN and RIFE dependencies (HEAVY - install early for better caching)
# Install basicsr with patch for torchvision compatibility
RUN pip install --no-cache-dir addict lmdb scipy Pillow pyyaml requests tb-nightly tqdm yapf && \
    pip install --no-cache-dir basicsr --no-deps && \
    # Patch basicsr only if the file exists (don't fail the build if not present)
    if [ -f /opt/venv/lib/python3.10/site-packages/basicsr/data/degradations.py ]; then \
        sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' /opt/venv/lib/python3.10/site-packages/basicsr/data/degradations.py; \
    fi && \
    rm -rf /root/.cache/pip /tmp/*

RUN pip install --no-cache-dir facexlib gfpgan && rm -rf /root/.cache/pip /tmp/*

RUN pip install --no-cache-dir timm einops && rm -rf /root/.cache/pip /tmp/*

# Install lightweight utilities and video processing libraries (change often - install last)
# NOTE: scikit-video removed - it's unmaintained (last update 2019) and has NumPy 2.x compatibility issues
# RIFE will use frame-by-frame method instead (more reliable)
RUN pip install --no-cache-dir \
    opencv-python-headless pillow tqdm pyyaml boto3 botocore \
    ffmpeg-python scikit-video scipy \
    imageio imageio-ffmpeg decorator moviepy \
    gdown && \
    rm -rf /root/.cache/pip /tmp/*

# --- NEW: OCR/Inpainting support (PaddleOCR/Tesseract + scikit-image) ---
# Install PaddleOCR with GPU support, pytesseract and scikit-image for subtitle detection and mask processing.
# Используем версию PaddlePaddle совместимую с CUDA 12.1
RUN pip install --no-cache-dir \
    scikit-image tqdm && \
    echo "Installing PaddlePaddle with GPU support for CUDA 12.1..." && \
    pip install --no-cache-dir paddlepaddle-gpu==2.5.2.post121 -f https://www.paddlepaddle.org.cn/whl/linux/mkl/avx/stable.html && \
    pip install --no-cache-dir paddleocr pytesseract && \
    rm -rf /root/.cache/pip /tmp/*

# Install Real-ESRGAN and RIFE as Python packages to avoid missing modules at runtime
RUN set -eux; \
    git clone --depth 1 https://github.com/xinntao/Real-ESRGAN.git /tmp/Real-ESRGAN && \
    cd /tmp/Real-ESRGAN && \
    pip install --no-cache-dir . && \
    cd / && \
    rm -rf /tmp/Real-ESRGAN && \
    git clone --depth 1 https://github.com/hzwer/arXiv2020-RIFE.git /tmp/RIFE && \
    cd /tmp/RIFE && \
    pip install --no-cache-dir torch-tb-profiler || true && \
    cd / && \
    rm -rf /tmp/RIFE /root/.cache/pip

# Create directory structure for RIFE models (will be downloaded automatically on first run)
# RIFE has built-in model downloading, we just ensure the directory exists
RUN mkdir -p /opt/rife_models/train_log

# Copy pre-downloaded RIFE models into image (faster and more reliable than runtime download)
# Using RIFE v4.26 (24MB model, better quality than v3.6)
COPY RIFEv4.26_0921/train_log/ /opt/rife_models/train_log/

# Download Real-ESRGAN models directly in image (faster and more reliable than COPY for large files)
# x2plus: 33 MB, x4plus: 67 MB
RUN mkdir -p /opt/realesrgan_models && \
    cd /opt/realesrgan_models && \
    echo "Downloading RealESRGAN_x2plus.pth (33 MB)..." && \
    wget -q --show-progress \
        https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth \
        -O RealESRGAN_x2plus.pth && \
    echo "Downloading RealESRGAN_x4plus.pth (67 MB)..." && \
    wget -q --show-progress \
        https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth \
        -O RealESRGAN_x4plus.pth && \
    echo "✓ Real-ESRGAN models downloaded successfully" && \
    ls -lh /opt/realesrgan_models/

# Force numpy<2 again in case any package upgraded it
RUN pip install --no-cache-dir --force-reinstall "numpy<2" && \
    rm -rf /root/.cache/pip

ENV PYTHONPATH="/workspace/project:/workspace/project/external/Real-ESRGAN:/workspace/project/external/RIFE"


# Enable strict frame count validation by default (ensures Real-ESRGAN doesn't change frame count)
# Set to 0 to allow frame count changes (faster but less accurate)
ENV STRICT_FRAME_COUNT=1

# Copy entrypoint script that updates project from Git on every container start
COPY scripts/entrypoint.sh /entrypoint.sh
# --- PROPAINTER BLOCK ---
RUN pip install --no-cache-dir imageio scipy scikit-image

# Клонируем ProPainter
WORKDIR /opt
RUN git clone https://github.com/sczhou/ProPainter.git

# Качаем веса (3 файла) с прогресс-баром
WORKDIR /opt/ProPainter/weights
RUN echo "Downloading ProPainter weights..." && \
    wget -q --show-progress https://github.com/sczhou/ProPainter/releases/download/v0.1.0/ProPainter.pth && \
    wget -q --show-progress https://github.com/sczhou/ProPainter/releases/download/v0.1.0/raft-things.pth && \
    wget -q --show-progress https://github.com/sczhou/ProPainter/releases/download/v0.1.0/recurrent_flow_completion.pth && \
    echo "✓ ProPainter weights downloaded"

# Возвращаем рабочую директорию
WORKDIR /workspace/project
ENV PROPAINTER_ROOT="/opt/ProPainter"
ENV PYTHONPATH="${PYTHONPATH}:/opt/ProPainter"
ENV CUDA_VISIBLE_DEVICES="0"
ENV NVIDIA_VISIBLE_DEVICES="all"
ENV NVIDIA_DRIVER_CAPABILITIES="compute,utility"

# Создаем улучшенный скрипт для проверки GPU при запуске с поддержкой разных GPU
RUN echo '#!/bin/bash
echo "=========================================="
echo "GPU Diagnostics (run-time check)"
echo "=========================================="
echo "Checking compatibility with various GPUs (RTX 2060, RTX 3080, etc.)..."

python3 -c "
import torch
print(f\"PyTorch version: {torch.__version__}\")
print(f\"PyTorch built with CUDA: {\"cu\" in torch.__version__}\")

# Проверяем доступность CUDA
cuda_available = torch.cuda.is_available()
print(f\"CUDA available at runtime: {cuda_available}\")

if cuda_available:
    device_count = torch.cuda.device_count()
    print(f\"Number of GPUs detected: {device_count}\")
    
    for i in range(device_count):
        print(f\"\\n--- GPU {i} ---\")
        print(f\"Name: {torch.cuda.get_device_name(i)}\")
        
        try:
            props = torch.cuda.get_device_properties(i)
            print(f\"Compute capability: {props.major}.{props.minor}\")
            print(f\"GPU memory: {props.total_memory / 1e9:.2f} GB\")
            
            # Проверяем совместимость с разными GPU
            gpu_name = torch.cuda.get_device_name(i).lower()
            if \"rtx 50\" in gpu_name or \"rtx 5090\" in gpu_name or \"rtx 5080\" in gpu_name:
                print(\"✓ RTX 5000 series detected - fully compatible with CUDA 12.1\")
                print(\"  Architecture: Ada Lovelace (compute capability 8.9+)\")
                print(\"  Expected performance: Excellent (16-32 GB VRAM)\")
                print(\"  Note: Newest architecture, optimal for AI workloads\")
            elif \"rtx 40\" in gpu_name or \"rtx 4090\" in gpu_name or \"rtx 4080\" in gpu_name:
                print(\"✓ RTX 4000 series detected - fully compatible with CUDA 12.1\")
                print(\"  Architecture: Ada Lovelace (compute capability 8.9)\")
                print(\"  Expected performance: Excellent (12-24 GB VRAM)\")
            elif \"rtx 3080\" in gpu_name or \"rtx 3090\" in gpu_name:
                print(\"✓ RTX 3000 series detected - fully compatible with CUDA 12.1\")
                print(\"  Architecture: Ampere (compute capability 8.6-8.9)\")
                print(\"  Expected performance: Excellent (10-24 GB VRAM)\")
            elif \"rtx 2060\" in gpu_name or \"rtx 2070\" in gpu_name or \"rtx 2080\" in gpu_name:
                print(\"✓ RTX 2000 series detected - fully compatible with CUDA 12.1\")
                print(\"  Architecture: Turing (compute capability 7.5)\")
                print(\"  Expected performance: Good (6-11 GB VRAM)\")
            elif \"rtx 3060\" in gpu_name or \"rtx 3070\" in gpu_name:
                print(\"✓ RTX 3000 series (GA10x) detected - fully compatible with CUDA 12.1\")
                print(\"  Architecture: Ampere (compute capability 8.6)\")
                print(\"  Expected performance: Very Good (8-12 GB VRAM)\")
            elif \"gtx\" in gpu_name or \"titan\" in gpu_name:
                print(\"✓ Legacy NVIDIA GPU detected - may work with limitations\")
                print(\"  Check compute capability >= 3.5\")
            elif \"quadro\" in gpu_name or \"tesla\" in gpu_name:
                print(\"✓ Professional/workstation GPU detected - fully compatible\")
                print(\"  Optimized for compute workloads\")
            else:
                print(\"✓ NVIDIA GPU detected - should work\")
                
            # Проверяем compute capability
            if props.major >= 7:
                print(f\"✓ Compute capability {props.major}.{props.minor} is excellent for AI workloads\")
            elif props.major >= 6:
                print(f\"✓ Compute capability {props.major}.{props.minor} is good for AI workloads\")
            elif props.major >= 3:
                print(f\"⚠ Compute capability {props.major}.{props.minor} may have performance limitations\")
            else:
                print(f\"⚠ Compute capability {props.major}.{props.minor} may not be fully supported\")
                
        except Exception as e:
            print(f\"Error getting GPU properties: {e}\")
    
    print(\"\\n✓ All detected GPUs are available for ProPainter and PyTorch\")
    
else:
    print(\"\\n⚠️  CUDA not available at runtime!\")
    print(\"   ProPainter will use CPU (slower but functional)\")
    print(\"   To enable GPU, ensure:\")
    print(\"   1. Docker is running with --gpus flag (docker run --gpus all ...)\")
    print(\"   2. NVIDIA drivers are installed on host (nvidia-smi should work)\")
    print(\"   3. Host has compatible GPU (NVIDIA with compute capability >= 3.5)\")
    print(\"   4. CUDA version matches (this image uses CUDA 12.1, forward compatible with 12.2-12.4)\")
    
    # Проверяем nvidia-smi для диагностики
    import subprocess
    try:
        result = subprocess.run([\"nvidia-smi\"], capture_output=True, text=True)
        if result.returncode == 0:
            print(\"\\nnvidia-smi output (first 5 lines):\")
            for line in result.stdout.split(\"\\n\")[:5]:
                if line.strip():
                    print(f\"  {line.strip()}\")
        else:
            print(\"\\nnvidia-smi not available or failed\")
    except:
        print(\"\\nCould not run nvidia-smi\")
"
echo "=========================================="
' > /usr/local/bin/check_gpu.sh && chmod +x /usr/local/bin/check_gpu.sh

# Добавляем проверку GPU в entrypoint для автоматической диагностики при запуске
RUN echo '#!/bin/bash
# Run GPU diagnostics
/usr/local/bin/check_gpu.sh

# Continue with original entrypoint
exec "$@"
' > /usr/local/bin/entrypoint_with_gpu_check.sh && chmod +x /usr/local/bin/entrypoint_with_gpu_check.sh

# Pre-download PaddleOCR models for faster startup (using improved script)
COPY docker/preload_paddleocr_fixed.py /tmp/preload_paddleocr.py
RUN mkdir -p /root/.paddlex/official_models && \
    echo "==========================================" && \
    echo "Pre-downloading PaddleOCR models..." && \
    echo "==========================================" && \
    DISABLE_MODEL_SOURCE_CHECK=True python3 /tmp/preload_paddleocr.py && \
    echo "==========================================" && \
    echo "PaddleOCR models pre-download completed" && \
    echo "=========================================="

RUN chmod +x /entrypoint.sh

# Set entrypoint with GPU check
ENTRYPOINT ["/usr/local/bin/entrypoint_with_gpu_check.sh", "/entrypoint.sh"]

# Default command: start a bash shell
CMD ["/bin/bash"]
