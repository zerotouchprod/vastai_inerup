# Dockerfile.vastai.optimized
# Optimized Dockerfile for Vast.ai with full NVIDIA RTX 30-50 series support
# This version uses CUDA 12.9.0 with PyTorch nightly for CUDA 12.6 compatibility
# Supports RTX 30 series (Ampere), 40 series (Ada Lovelace), 50 series (Blackwell)
# Also maintains backward compatibility with RTX 20 series (Turing)

FROM nvidia/cuda:12.9.0-cudnn-devel-ubuntu22.04
#FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies and clean up to save space
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    curl \
    git \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    gcc \
    g++ \
    make \
    cmake \
    ninja-build \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    tesseract-ocr \
    libtesseract-dev \
    libgl1-mesa-glx \
    && apt-get purge -y --auto-remove manpages manpages-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/* /usr/share/man/*

WORKDIR /workspace/project

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.8 (supports RTX 20-50 series including Blackwell sm_120)
# RTX 5080/5090 (Blackwell, CC 12.0) requires PyTorch built with sm_120 support
# PyTorch started supporting sm_120 in nightly builds around late 2024
# Using CUDA 12.8 wheels which are compatible with CUDA 12.9.0 runtime
# See: https://pytorch.org/get-started/locally/
RUN echo "Checking disk space before PyTorch installation..." && \
    df -h && \
    rm -rf /root/.cache/pip && \
    pip uninstall -y torch torchvision torchaudio 2>/dev/null || true && \
    echo "Installing PyTorch with CUDA 12.8 for RTX 20-50 series (including Blackwell sm_120)..." && \
    pip install --no-cache-dir --pre \
        torch \
        torchvision \
        torchaudio \
        --index-url https://download.pytorch.org/whl/nightly/cu128 && \
    echo "PyTorch installation complete" && \
    python3 -c "import torch; print(f'PyTorch version: {torch.__version__}'); print(f'CUDA version: {torch.version.cuda if hasattr(torch.version, \"cuda\") else \"N/A\"}'); print(f'CUDA available: {torch.cuda.is_available()}'); print(f'Supported CCs: {[int(x.split(\"_\")[1])/10 for x in torch.cuda.get_arch_list()] if hasattr(torch.cuda, \"get_arch_list\") and torch.cuda.is_available() else \"Checking at runtime...\"}')" && \
    rm -rf /root/.cache/pip && \
    echo "Disk space after installation:" && \
    df -h

# Install numpy with compatibility fix
RUN pip install --no-cache-dir "numpy<2" && \
    rm -rf /root/.cache/pip

# Install video processing dependencies
RUN pip install --no-cache-dir \
    opencv-python-headless pillow tqdm pyyaml boto3 botocore \
    ffmpeg-python scikit-video scipy \
    imageio imageio-ffmpeg decorator moviepy \
    gdown && \
    rm -rf /root/.cache/pip /tmp/*

# Install OCR dependencies
RUN pip install --no-cache-dir \
    dataclasses-json>=0.6.0 \
    pydantic_settings==2.12.0 \
    pytesseract \
    easyocr>=1.7.1 && \
    rm -rf /root/.cache/pip /tmp/*

# Install Real-ESRGAN with proper dependencies
RUN git clone --depth 1 https://github.com/xinntao/Real-ESRGAN.git /tmp/Real-ESRGAN && \
    cd /tmp/Real-ESRGAN && \
    pip install --no-cache-dir basicsr && \
    # Patch basicsr for torchvision compatibility (functional_tensor was removed)
    if [ -f /opt/venv/lib/python3.10/site-packages/basicsr/data/degradations.py ]; then \
        sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' /opt/venv/lib/python3.10/site-packages/basicsr/data/degradations.py; \
    fi && \
    pip install --no-cache-dir . && \
    cd / && \
    rm -rf /tmp/Real-ESRGAN /root/.cache/pip

# Install RIFE
RUN git clone --depth 1 https://github.com/hzwer/arXiv2020-RIFE.git /tmp/RIFE && \
    cd /tmp/RIFE && \
    pip install --no-cache-dir torch-tb-profiler || true && \
    cd / && \
    rm -rf /tmp/RIFE /root/.cache/pip

# Download models
RUN mkdir -p /opt/realesrgan_models && \
    cd /opt/realesrgan_models && \
    wget -q --show-progress https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth && \
    wget -q --show-progress https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth

RUN mkdir -p /opt/rife_models/train_log
COPY RIFEv4.26_0921/train_log/ /opt/rife_models/train_log/

# Environment variables for CUDA compatibility
ENV CUDA_VISIBLE_DEVICES="0"
ENV NVIDIA_VISIBLE_DEVICES="all"
ENV NVIDIA_DRIVER_CAPABILITIES="compute,utility"
ENV CUDA_HOME="/usr/local/cuda"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# ============================================================================
# CRITICAL: CUDA Architecture Compatibility for ALL Vast.ai GPUs
# ============================================================================
# This MUST be set BEFORE compiling any CUDA extensions (ProPainter, SAM2, etc.)
# to create "fat" binaries that work on multiple GPU architectures.
#
# Supported architectures:
#   7.5 = Turing (RTX 20 series: 2080/2080Ti, Tesla T4)
#   8.0 = Ampere (A100, A30)
#   8.6 = Ampere (RTX 30 series: 3090/3080, A10, A40)
#   8.9 = Ada Lovelace (RTX 40 series: 4090/4080, L40/L40S)
#   9.0 = Hopper (H100, H200)
#   9.0+PTX = Forward compatibility for future architectures (RTX 50 series, etc.)
#
# PTX (Parallel Thread Execution) enables forward compatibility:
# - Binary includes PTX intermediate representation
# - JIT compiles to actual architecture at runtime
# - Works on newer GPUs without rebuild (e.g., RTX 5090 Blackwell)
#
# Without PTX, extensions would need rebuild for each new GPU generation.
# ============================================================================
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0;9.0+PTX"

# SAM 2 Installation
ENV FORCE_CUDA="1"
ENV MAX_JOBS="4"
RUN pip install --no-cache-dir --no-build-isolation git+https://github.com/facebookresearch/segment-anything-2.git

# Download SAM 2 Checkpoint
RUN mkdir -p /opt/sam2_checkpoints && \
    wget -q https://dl.fbaipublicfiles.com/segment_anything_2/072824/sam2_hiera_small.pt -O /opt/sam2_checkpoints/sam2_hiera_small.pt

# ProPainter Installation with Multi-Architecture Support
# TORCH_CUDA_ARCH_LIST set above ensures this builds "fat" binaries for all GPUs
# Note: spatial-correlation-sampler will be rebuilt at runtime by entrypoint.sh
# to match the exact CUDA version on the Vast.ai instance
RUN pip install --no-cache-dir imageio scipy scikit-image && \
    pip install --no-cache-dir av torchvision && \
    git clone https://github.com/sczhou/ProPainter.git /opt/ProPainter && \
    cd /opt/ProPainter && \
    pip install --no-cache-dir -r requirements.txt && \
    # Pre-install spatial-correlation-sampler (will be rebuilt at runtime if needed)
    # The TORCH_CUDA_ARCH_LIST above forces compilation for all specified architectures
    # This creates a single binary that works on RTX 20/30/40/50, A100, H100, etc.
    echo "Building spatial-correlation-sampler for architectures: $TORCH_CUDA_ARCH_LIST" && \
    pip uninstall -y spatial-correlation-sampler 2>/dev/null || true && \
    pip install --no-cache-dir spatial-correlation-sampler && \
    echo "✅ spatial-correlation-sampler pre-installed (will be rebuilt at runtime if CUDA mismatch)" && \
    # Download model weights
    cd /opt/ProPainter/weights && \
    wget -q --show-progress https://github.com/sczhou/ProPainter/releases/download/v0.1.0/ProPainter.pth && \
    wget -q --show-progress https://github.com/sczhou/ProPainter/releases/download/v0.1.0/raft-things.pth && \
    wget -q --show-progress https://github.com/sczhou/ProPainter/releases/download/v0.1.0/recurrent_flow_completion.pth && \
    # Cleanup
    rm -rf /root/.cache/pip /tmp/*

ENV PROPAINTER_ROOT="/opt/ProPainter"

# ============================================================================
# NEW LAYER: Lightweight Inpainting dependencies (LaMa & STTN)
# This preserves cache for previous heavy layers (PyTorch, CUDA, ProPainter)
# ============================================================================
RUN pip install --no-cache-dir \
    hydra-core \
    pytorch-lightning \
    kornia \
    webdataset \
    && rm -rf /root/.cache/pip /tmp/*

# Install LaMa implementation from official repository
RUN git clone https://github.com/saic-mdal/lama.git /opt/lama && \
    cd /opt/lama && \
    pip install --no-cache-dir -e . && \
    echo "✅ LaMa installed from official repository"

# Create directories for LaMa and STTN models
RUN mkdir -p /opt/lama_models /opt/sttn_models

# Download LaMa weights (big-lama.pt) during build to avoid runtime download
RUN cd /opt/lama_models && \
    wget -q --show-progress https://github.com/Sanster/models/releases/download/add_big_lama/big-lama.pt && \
    echo "✅ LaMa weights downloaded to /opt/lama_models/big-lama.pt"

ENV PYTHONPATH="/workspace/project:/workspace/project/external/Real-ESRGAN:/workspace/project/external/RIFE:${PYTHONPATH}"

# Copy entrypoint
COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
