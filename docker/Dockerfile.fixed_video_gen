# Dockerfile.fixed_video_gen (2026 Fixed Video Generation Edition)
# Optimized for RTX 4090 / 5090 with complete models baked in
# Stack: PyTorch 2.5+, CUDA 12.4, CogVideoX-5b-I2V + DreamShaper XL Lightning
# Key features: Complete models, no symlinks, fixed paths, working video generation

# ============================================
# Stage 1: Downloader (Complete models download)
# ============================================
FROM ubuntu:22.04 AS downloader

# Install minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && pip3 install --no-cache-dir huggingface_hub

# Setup model cache
ENV HF_HOME="/model_cache"
RUN mkdir -p /model_cache

# Download models (anonymous, complete files)
# 1. CogVideoX-5b-I2V (video generation) - COMPLETE download
RUN echo "Downloading CogVideoX-5b-I2V (complete)..." && \
    python3 -m huggingface_hub.cli.hf download THUDM/CogVideoX-5b-I2V \
        --local-dir /model_cache/THUDM--CogVideoX-5b-I2V

# 2. DreamShaper XL Lightning (image generation) - COMPLETE download
RUN echo "Downloading DreamShaper XL Lightning (complete)..." && \
    python3 -m huggingface_hub.cli.hf download Lykon/dreamshaper-xl-lightning \
        --local-dir /model_cache/Lykon--dreamshaper-xl-lightning

# Verify downloads
RUN echo "Verifying model files..." && \
    find /model_cache -name "*.safetensors" | wc -l && \
    du -sh /model_cache/*

# Clean up pip cache
RUN rm -rf /root/.cache/pip

# ============================================
# Stage 2: Builder (Python environment)
# ============================================
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 as builder

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /tmp

# Copy requirements
COPY requirements.gen.txt .

# Install PyTorch with CUDA 12.4
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        torch==2.5.1+cu124 \
        torchvision==0.20.1+cu124 \
        torchaudio==2.5.1+cu124 \
        --index-url https://download.pytorch.org/whl/cu124

# Install other dependencies
RUN pip install --no-cache-dir -r requirements.gen.txt

# Install xformers for optimization
RUN pip install --no-cache-dir xformers --index-url https://download.pytorch.org/whl/cu124

# Clean up
RUN rm -rf /root/.cache/pip

# ============================================
# Stage 3: Runtime (Final image)
# ============================================
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

LABEL maintainer="vastai_inerup"
LABEL description="Fixed Video Generation 2026 (RTX 50xx Ready) - Complete models baked in"
LABEL gpu.min_vram_gb="24"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy models from downloader to CORRECT location
COPY --from=downloader /model_cache /root/.cache/huggingface

# Copy source code
COPY src/ /app/src/

# Environment variables - MUST match code expectations
ENV HF_HOME="/root/.cache/huggingface"
ENV HF_HUB_OFFLINE="1"
ENV TORCH_INFERENCE_MODE="1"
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Verify models are accessible
RUN echo "Verifying models in container..." && \
    find /root/.cache/huggingface -name "*.safetensors" | head -5 && \
    echo "Total safetensors files:" && \
    find /root/.cache/huggingface -name "*.safetensors" | wc -l

# Test basic imports
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')"

# Default command
CMD ["python3", "-m", "src.entrypoints.run_gen", "--help"]

# ============================================
# Key fixes:
# 1. --local-dir-use-symlinks False ensures REAL files, not symlinks
# 2. Models copied to /root/.cache/huggingface (matches HF_HOME)
# 3. Complete model downloads (not partial)
# 4. Verified paths match code expectations
# 5. All dependencies installed
# Expected size: ~40GB (with complete models)
# ============================================