# Build: docker build -f Dockerfile.pytorch.fat -t vastai-interup:pytorch-fat .

FROM nvidia/cuda:12.6.0-cudnn-runtime-ubuntu22.04 AS base

# Метки для порядка
LABEL description="Pure Execution Environment: PyTorch Nightly + Real-ESRGAN + RIFE + OCR"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# Запрещаем Python создавать .pyc файлы (экономия места и IO)
ENV PYTHONDONTWRITEBYTECODE=1

# 1. Системные зависимости (Минимальный набор для OpenCV, FFmpeg и OCR)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget curl git \
    python3-pip python3-venv \
    ffmpeg \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 \
    tesseract-ocr libtesseract-dev libgl1-mesa-glx \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/project

# 2. Виртуальное окружение
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Обновляем pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 3. PyTorch Nightly (Force Install Strategy) with CUDA 12.6 support
# Используем --no-deps для torchvision/audio, чтобы игнорировать conflicts версий в Nightly
RUN pip uninstall -y torch torchvision torchaudio || true && \
    pip install --no-cache-dir --pre torch --index-url https://download.pytorch.org/whl/nightly/cu126 && \
    pip install --no-cache-dir --pre torchvision torchaudio --no-deps --index-url https://download.pytorch.org/whl/nightly/cu126 && \
    rm -rf /root/.cache/pip

# 4. Фиксация Numpy (Критично для совместимости)
RUN pip install --no-cache-dir "numpy<2.0.0"

# 5. Тяжелые зависимости (Real-ESRGAN / RIFE)
# Сначала ставим мелкие зависимости, потом basicsr без зависимостей (чтобы не тянул старый torch)
RUN pip install --no-cache-dir addict lmdb scipy Pillow pyyaml requests tb-nightly tqdm yapf future && \
    pip install --no-cache-dir basicsr --no-deps && \
    # Патч basicsr (исправление ошибки импорта в новых torchvision)
    if [ -f /opt/venv/lib/python3.10/site-packages/basicsr/data/degradations.py ]; then \
        sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' /opt/venv/lib/python3.10/site-packages/basicsr/data/degradations.py; \
    fi && \
    pip install --no-cache-dir facexlib gfpgan timm einops && \
    rm -rf /root/.cache/pip

# 6. Утилиты для обработки видео и масок
RUN pip install --no-cache-dir \
    opencv-python-headless \
    pillow tqdm pyyaml boto3 botocore \
    ffmpeg-python imageio imageio-ffmpeg decorator moviepy \
    gdown && \
    rm -rf /root/.cache/pip

# 7. OCR и Inpainting (Subtitle Removal)
# ВАЖНО: Ставим PaddlePaddle CPU версию (linux_x86_64), чтобы не тянуть лишнюю CUDA
RUN pip install --no-cache-dir paddleocr pytesseract scikit-image && \
    pip install --no-cache-dir paddlepaddle==2.6.1 -f https://www.paddlepaddle.org.cn/packages/stable/cpu/ && \
    rm -rf /root/.cache/pip

# 8. Установка Real-ESRGAN и RIFE как пакетов
RUN set -eux; \
    git clone --depth 1 https://github.com/xinntao/Real-ESRGAN.git /tmp/Real-ESRGAN && \
    cd /tmp/Real-ESRGAN && pip install --no-cache-dir . && \
    rm -rf /tmp/Real-ESRGAN && \
    git clone --depth 1 https://github.com/hzwer/arXiv2020-RIFE.git /tmp/RIFE && \
    cd /tmp/RIFE && pip install --no-cache-dir torch-tb-profiler || true && \
    rm -rf /tmp/RIFE

# 9. Модели (Pre-load)
# RIFE Models (Копируем локальные)
RUN mkdir -p /opt/rife_models/train_log
COPY RIFEv4.26_0921/train_log/ /opt/rife_models/train_log/

# Real-ESRGAN Models (Скачиваем)
RUN mkdir -p /opt/realesrgan_models && \
    cd /opt/realesrgan_models && \
    wget -q --show-progress https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth && \
    wget -q --show-progress https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth

# 10. Финальная настройка
# Перестраховка по numpy
RUN pip install --no-cache-dir --force-reinstall "numpy<2.0.0" && rm -rf /root/.cache/pip

# Переменные окружения для скриптов
ENV PYTHONPATH="/workspace/project"
ENV STRICT_FRAME_COUNT=1
# Указываем, где искать модели (если ваши скрипты используют эти ENV)
ENV RIFE_MODEL_DIR="/opt/rife_models/train_log"
ENV REALESRGAN_MODEL_DIR="/opt/realesrgan_models"
# CUDA architecture support for RTX 20-50 series
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.7;8.9;9.0;12.0"
ENV CUDA_HOME="/usr/local/cuda"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# Скрипт входа
COPY scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
# По дефолту ничего не делаем, ждем команду от vast.ai или orchestrator
CMD ["python3", "--version"]
