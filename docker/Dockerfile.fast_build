# Dockerfile.fast_build - Быстрая сборка без кэша
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

LABEL maintainer="vastai_inerup"
LABEL description="Fast Video Generation Build - Complete models baked in"
LABEL gpu.min_vram_gb="24"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install PyTorch with CUDA 12.4 (updated to fix CVE-2025-32434)
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        torch==2.6.0+cu124 \
        torchvision==0.21.0+cu124 \
        torchaudio==2.6.0+cu124 \
        --index-url https://download.pytorch.org/whl/cu124

# Install dependencies
COPY requirements.gen.txt .
RUN pip install --no-cache-dir -r requirements.gen.txt

# Install xformers for optimization (compatible with torch 2.6.0)
RUN pip install --no-cache-dir xformers==0.0.29.post3 --index-url https://download.pytorch.org/whl/cu124

# Install huggingface_hub for model download
RUN pip install --no-cache-dir huggingface_hub

# Setup model cache
ENV HF_HOME="/root/.cache/huggingface"
RUN mkdir -p /root/.cache/huggingface

# Download models directly (no separate stage)
RUN echo "Downloading CogVideoX-5b-I2V..." && \
    python3 -m huggingface_hub.cli.hf download THUDM/CogVideoX-5b-I2V \
        --local-dir /root/.cache/huggingface/THUDM--CogVideoX-5b-I2V

RUN echo "Downloading DreamShaper XL Lightning..." && \
    python3 -m huggingface_hub.cli.hf download Lykon/dreamshaper-xl-lightning \
        --local-dir /root/.cache/huggingface/Lykon--dreamshaper-xl-lightning

# Copy source code
COPY src/ /app/src/

# Environment variables
ENV HF_HUB_OFFLINE="1"
ENV TORCH_INFERENCE_MODE="1"
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Verify models
RUN echo "Verifying models..." && \
    find /root/.cache/huggingface -name "*.safetensors" | head -5 && \
    echo "Total safetensors files:" && \
    find /root/.cache/huggingface -name "*.safetensors" | wc -l

# Test imports
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')"

RUN apt-get update && apt-get install -y --no-install-recommends \
    git

# Default command
CMD ["python3", "-m", "src.entrypoints.run_gen", "--help"]