# Dockerfile.gen (2026 High-Performance Edition)
# Optimized for RTX 4090 / 5090 (Blackwell/Ada)
# Stack: PyTorch 2.5+, CUDA 12.4, CogVideoX-5b-I2V Baked-in

# ============================================
# Stage 1: Downloader (Heavy lifting)
# ============================================
# Используем devel образ, чтобы был git и компиляторы, если понадобятся
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel as downloader

# Cache busting argument to force pip install to run
ARG CACHEBUST=1

# Очищаем кэш сразу, чтобы не занимать место
RUN apt-get update && apt-get install -y git && \
    pip install --no-cache-dir "huggingface_hub[cli]" && \
    rm -rf /var/lib/apt/lists/*

# Проверяем что huggingface-cli установлен
RUN python -c "import huggingface_hub; print(f'huggingface_hub version: {huggingface_hub.__version__}')" && \
    python -m huggingface_hub.cli.hf --help 2>&1 | head -5

# Создаем папку для модели
ENV HF_HOME="/model_cache"
RUN mkdir -p /model_cache

# Скачиваем модель (THUDM/CogVideoX-5b-I2V)
# FIX: Используем python -m huggingface_hub.cli.hf which is the hf command
RUN python -m huggingface_hub.cli.hf download THUDM/CogVideoX-5b-I2V \
    --include "*.safetensors" "*.json" "*.txt" "scheduler/*" "tokenizer/*" "transformer/*" "vae/*" "text_encoder/*" \
    --exclude "*.bin" "*.onnx" "*.pb" "fp32/*" \
    --cache-dir /model_cache

# ============================================
# Stage 2: Runtime (Slim & Fast)
# ============================================
# Переходим на Runtime образ (меньше весит)
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

LABEL maintainer="vastai_inerup"
LABEL description="Video Gen Worker 2026 (RTX 50xx Ready)"
LABEL gpu.min_vram_gb="24"

# Системные зависимости (FFmpeg нужен свежий)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем зависимости
COPY requirements.gen.txt /app/

# Устанавливаем Python пакеты
# ВАЖНО: --no-cache-dir критичен для твоих 60 ГБ диска!
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.gen.txt && \
    # Дополнительные оптимизации для 50-й серии (если есть в requirements, но на всякий случай)
    pip install --no-cache-dir xformers --index-url https://download.pytorch.org/whl/cu124

# Копируем МОДЕЛЬ из первого этапа
COPY --from=downloader /model_cache /root/.cache/huggingface

# Копируем код
COPY src/ /app/src/

# Настройка ENV
ENV HF_HOME="/root/.cache/huggingface"
ENV HF_HUB_OFFLINE="1"
ENV TORCH_INFERENCE_MODE="1"
ENV PYTHONPATH="/app:$PYTHONPATH"
# Оптимизация памяти для PyTorch 2.5+
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

CMD ["python", "-m", "src.entrypoints.run_gen", "--help"]