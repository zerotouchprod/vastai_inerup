FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    curl \
    git \
    python3-pip \
    python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Create and use venv
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install paddlepaddle with noavx
RUN pip install --no-cache-dir paddlepaddle==2.5.2 -f https://www.paddlepaddle.org.cn/whl/linux/cpu-mkl-noavx.html

# Install paddleocr
RUN pip install --no-cache-dir paddleocr

# Copy test script
COPY preload_paddleocr_fixed.py /tmp/preload_paddleocr.py

# Test the script
RUN mkdir -p /root/.paddlex/official_models && \
    echo "Testing PaddleOCR pre-download..." && \
    DISABLE_MODEL_SOURCE_CHECK=True python3 /tmp/preload_paddleocr.py && \
    echo "Test completed successfully"
