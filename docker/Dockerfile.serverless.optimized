# Dockerfile.serverless.optimized - Ultra-fast startup image
# Base: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
# Size: ~6GB (all dependencies pre-installed, NO models)
# Models will be loaded from Network Volume at /runpod-volume
# This image is designed to be cached on RunPod hosts for instant startup

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime AS builder

LABEL maintainer="vastai_inerup"
LABEL description="RunPod Serverless Video Generation - Optimized for fast startup"
LABEL version="3.0.0"

# System dependencies (minimal set)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install base dependencies
RUN pip install --no-cache-dir --upgrade pip

# Copy requirements file
COPY requirements.gen.txt .

# Install Python dependencies from requirements.gen.txt
# Using --no-deps to avoid unnecessary dependencies
RUN pip install --no-cache-dir -r requirements.gen.txt

# Install RunPod and additional serverless dependencies
RUN pip install --no-cache-dir \
    runpod==1.8.1 \
    boto3==1.34.0

# Install xformers for optimization
RUN pip install --no-cache-dir xformers==0.0.29.post1 --index-url https://download.pytorch.org/whl/cu124

# Copy source code (minimal)
COPY src/entrypoints/runpod_handler.py /app/src/entrypoints/
COPY src/services/video_generation_service.py /app/src/services/
COPY src/infrastructure/__init__.py /app/src/infrastructure/
COPY src/infrastructure/diffusion/__init__.py /app/src/infrastructure/diffusion/
COPY src/infrastructure/diffusion/dreamshaper_adapter.py /app/src/infrastructure/diffusion/
COPY src/infrastructure/diffusion/cogvideox_adapter.py /app/src/infrastructure/diffusion/
COPY src/shared/__init__.py /app/src/shared/
COPY src/shared/logging.py /app/src/shared/
COPY src/core/__init__.py /app/src/core/
COPY src/core/config.py /app/src/core/

# Create minimal __init__.py files
RUN echo "" > /app/src/__init__.py && \
    echo "" > /app/src/entrypoints/__init__.py && \
    echo "" > /app/src/services/__init__.py

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create model directory structure (will be mounted from network volume)
RUN mkdir -p /runpod-volume/models

# Environment variables for RunPod
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
ENV HF_HOME="/runpod-volume/huggingface"
ENV TORCH_INFERENCE_MODE="1"
ENV ENABLE_SAFETY_CHECKER="False"

# Verify installation (quick check)
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.cuda.is_available()}')" && \
    python3 -c "import diffusers; print(f'Diffusers: {diffusers.__version__}')" && \
    python3 -c "import runpod; print(f'RunPod: {runpod.__version__}')"

# Clean up to reduce image size
RUN rm -rf /tmp/* /var/tmp/* && \
    rm -rf /root/.cache/pip/* && \
    rm -rf /root/.cache/huggingface/*

# Create a health check script
RUN echo '#!/bin/bash\npython3 -c "import torch; exit(0 if torch.cuda.is_available() else 1)"' > /healthcheck.sh && \
    chmod +x /healthcheck.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /healthcheck.sh

# Default command for RunPod Serverless (uses entrypoint script)
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Final stage - minimal
FROM builder AS final

# Keep only essential files
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app
COPY --from=builder /usr/local/bin/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --from=builder /healthcheck.sh /healthcheck.sh

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app:$PYTHONPATH"

# Final size check
RUN du -sh /opt/venv && \
    du -sh /app && \
    echo "Optimized image ready for fast startup"