[Unit]
Description=AIVIDUP isolated one-job RIFE + Real-ESRGAN test plane (loopback only)
After=network.target

[Service]
Type=simple
User=informaten
Group=informaten
StateDirectory=aividup-runpod-pilot
StateDirectoryMode=0700
WorkingDirectory=/var/lib/aividup-runpod-pilot
EnvironmentFile=/etc/aividup-runpod-pilot/plane.env
ExecStartPre=/usr/bin/test -s /etc/aividup-runpod-pilot/plane.token
ExecStartPre=/usr/bin/test -s ${AIVIDUP_PILOT_INPUT}
ExecStart=/usr/bin/python3 /opt/aividup-runpod-pilot/runpod_pilot_test_control_plane.py --token-file /etc/aividup-runpod-pilot/plane.token --input ${AIVIDUP_PILOT_INPUT} --host 127.0.0.1 --port 8099 --advertised-base-url http://127.0.0.1:18099/api/worker --evidence ${AIVIDUP_PILOT_EVIDENCE} --output-dir ${AIVIDUP_PILOT_OUTPUT_DIR} --mode ${AIVIDUP_PILOT_MODE} --scale ${AIVIDUP_PILOT_SCALE} --interp-factor ${AIVIDUP_PILOT_INTERP_FACTOR} --strategy ${AIVIDUP_PILOT_STRATEGY}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/aividup-runpod-pilot

[Install]
WantedBy=multi-user.target
