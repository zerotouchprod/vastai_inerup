[Unit]
Description=AIVIDUP isolated one-job RIFE test plane (loopback only)
After=network.target

[Service]
Type=simple
User=informaten
Group=informaten
StateDirectory=aividup-runpod-pilot
StateDirectoryMode=0700
WorkingDirectory=/var/lib/aividup-runpod-pilot
ExecStartPre=/usr/bin/test -s /etc/aividup-runpod-pilot/plane.token
ExecStartPre=/usr/bin/test -s /var/lib/aividup-runpod-pilot/input.mp4
ExecStart=/usr/bin/python3 /opt/aividup-runpod-pilot/runpod_pilot_test_control_plane.py --token-file /etc/aividup-runpod-pilot/plane.token --input /var/lib/aividup-runpod-pilot/input.mp4 --host 127.0.0.1 --port 8099 --advertised-base-url http://127.0.0.1:18099/api/worker --evidence /var/lib/aividup-runpod-pilot/plane-evidence.json --mode interp --interp-factor 2.0
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/aividup-runpod-pilot

[Install]
WantedBy=multi-user.target
