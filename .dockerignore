# Ignore Git metadata
.git
.gitlab-ci.yml

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
venv/
.venv/
.venv*/
env/

# Virtualenv and pip cache
pip-wheel-metadata/
root/.cache/
**/.cache/

# Large outputs - videos, temporary outputs
out_*
out_*/
out_4k/
out_upscale/
out_interp/
out_upscale/*
tmp_*/
tmp_*/
out_upscale/

# Common media formats (skip large binaries)
*.mp4
*.mkv
*.mov
*.avi

# Build artifacts
dist/
build/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Editor settings
.vscode/
.idea/

# Kaniko/CI temp
.kaniko/

# Any other heavy folders/files you don't want in image
out_*/

# ========================================
# Cleaner Image Specific (Dockerfile.cleaner)
# ========================================
# Exclude heavy model weights not needed for cleaning
*.pth
*.safetensors
*.ckpt
!ProPainter.pth  # Exception: Keep ProPainter

# Exclude RIFE/Real-ESRGAN specific files
RIFE_trained_model*/
RIFEv*/
realesrgan/
gfpgan/
external/

# Exclude dev/test artifacts
tests/
test_*/
dev_tests/
docs/
*.md
!README.md  # Exception: Keep README

# Exclude large test fixtures
tests/fixtures/videos/
test_img/
testsubs/

# End of file



